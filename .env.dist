# Copy to .env: cp .env.dist .env
# Values below are safe defaults for local development only.
# Hosts are docker compose service names: the app runs inside the compose network.

# --- Application ---
LOG_LEVEL=info
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# fx start/stop timeouts; keep APP_STOP_TIMEOUT below stop_grace_period (20s) in docker-compose.yml
APP_START_TIMEOUT=15s
APP_STOP_TIMEOUT=15s

# --- PostgreSQL (also used by the postgres container) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_agents
POSTGRES_SSL_MODE=disable

# --- Redis (password is also set on the redis container) ---
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=redis-dev-password
REDIS_DB=0

# --- S3 (RustFS in docker compose; keys are also its admin credentials) ---
S3_ENDPOINT=s3:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=media
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Telegram ---
# Local Bot API server (compose profile "telegram"); public API: https://api.telegram.org
TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081
# For the local Bot API server: https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram gateway (docs/SETUP.md, "Telegram-боты"). Without tokens the gateway is off; once any token is
# set, all four tokens, the group and the allowlist are required. Tokens come from @BotFather.
TELEGRAM_MARKETER_TOKEN=
TELEGRAM_COPYWRITER_TOKEN=
TELEGRAM_EDITOR_TOKEN=
TELEGRAM_DESIGNER_TOKEN=
# Team supergroup ID (-100...) and comma-separated Telegram user IDs that are heard; everyone else is ignored
TELEGRAM_GROUP_ID=
TELEGRAM_ALLOWED_USER_IDS=
# Who may run /onboard (comma-separated); empty — anyone of TELEGRAM_ALLOWED_USER_IDS
TELEGRAM_ADMIN_USER_IDS=
# Forum topic IDs (message_thread_id): «Планёрка», «Исходники», «Продакшн», «Техничка»
TELEGRAM_TOPIC_PLANNING_ID=
TELEGRAM_TOPIC_SOURCES_ID=
TELEGRAM_TOPIC_PRODUCTION_ID=
TELEGRAM_TOPIC_TECH_ID=
# Files of the local Bot API server (volume telegram-bot-api-data, read-only in app); media above the limit
# (bytes, 2 GiB) are not downloaded
TELEGRAM_FILES_DIR=/var/lib/telegram-bot-api
# Sender uploads files only from here (created on start, 0700); producers of drafts and covers write here
TELEGRAM_OUTBOX_DIR=/tmp/telegram-outbox
TELEGRAM_MAX_FILE_SIZE=2147483648
# getUpdates long polling (at least 1s); one ordinary request; getFile (the server downloads the file first) and uploads
TELEGRAM_POLL_TIMEOUT=50s
TELEGRAM_REQUEST_TIMEOUT=30s
TELEGRAM_FILE_TIMEOUT=15m
# Retries on 429 (retry_after is honoured), 5xx and network errors
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY=1s
TELEGRAM_RETRY_MAX_DELAY=30s
# Incoming events handled at once: without a file download, and with one (videos for the editor; own slots)
TELEGRAM_WORKERS=4
TELEGRAM_MEDIA_WORKERS=2
# Time zone (IANA) of the dates the trainer reads in the team chat (/ideas)
TEAM_TIMEZONE=Europe/Moscow
# Weekly pilot report to «Техничка»: English weekday and HH:MM in TEAM_TIMEZONE; both empty — off
PILOT_REPORT_WEEKDAY=
PILOT_REPORT_TIME=

# --- Media from the team chat (internal/media) ---
# Videos for the editor are copied to S3_BUCKET under <prefix>/<chat id>/<message id>/<file unique id>.<ext>
MEDIA_KEY_PREFIX=incoming
# The editor's results (reel, plan, decisions log, source transcript) next to the source by its message:
# <prefix>/<chat id>/<message id>/<file unique id>-v<version>-reel.mp4 ...; must differ from MEDIA_KEY_PREFIX
MEDIA_RESULT_PREFIX=edits
# Limit for copying one file to S3
MEDIA_UPLOAD_TIMEOUT=10m

# OpenAI (Whisper transcription, embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Whisper (transcription; read by cmd/transcribe only) ---
# whisper-1 is the only OpenAI model with word timestamps.
# TODO: OpenAI shuts whisper-1 down on 2027-02-26; choose a replacement with word timestamps (e.g. ElevenLabs Scribe).
WHISPER_MODEL=whisper-1
# ISO 639-1; empty means auto-detect
WHISPER_LANGUAGE=ru
WHISPER_REQUEST_TIMEOUT=5m
WHISPER_MAX_RETRIES=3
WHISPER_RETRY_BASE_DELAY=2s
# Pauses where long audio is cut into chunks: quieter than the level (dB) for at least the duration.
# Raise the level (e.g. -25) for videos with background music.
TRANSCRIPTION_SILENCE_NOISE_DB=-30
TRANSCRIPTION_SILENCE_MIN_DURATION=500ms
# Limit for one ffmpeg/ffprobe run (rendering a 3-minute reel with subtitles takes a few minutes)
FFMPEG_TIMEOUT=10m

# Rough cut (cmd/roughcut); flags -max-pause, -similarity, -fillers override these.
ROUGHCUT_MAX_PAUSE=400ms
ROUGHCUT_RETAKE_SIMILARITY=0.7
ROUGHCUT_FILLERS=э,эм,м,хм,uh,um,hm,er,erm

# --- Subtitles (read by cmd/subtitles only) ---
# Fonts directory; default assets/fonts. Left commented out on purpose: the media image sets /app/fonts, and
# `docker run --env-file .env` would override it with a host path.
# SUBTITLES_FONTS_DIR=assets/fonts
# YAML style (brand book); empty means the built-in style, written out in assets/subtitles/style.yaml.
SUBTITLES_STYLE_FILE=

# --- Claude API (LLM layer) ---
# Optional: without the key the app starts, and agent runs fail with "anthropic api key is not set".
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Timeout of one HTTP attempt
ANTHROPIC_TIMEOUT=5m
# Retries on 429, 5xx and network errors: delay = base * 2^attempt, capped by max (retry-after is honoured up to max)
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_RETRY_BASE_DELAY=1s
ANTHROPIC_RETRY_MAX_DELAY=30s
# Default model and max_tokens of agent runs; an agent may set its own model in agent.md
LLM_DEFAULT_MODEL=claude-sonnet-5-5
LLM_DEFAULT_MAX_TOKENS=8192
# USD per million tokens: model=input/output/cache_write/cache_read,... (cache_write = 5-minute cache)
# Source: https://platform.claude.com/docs/en/about-claude/pricing. Calls of a model without a price
# are recorded with tokens and a NULL cost.
LLM_PRICES=claude-sonnet-5-5=2/10/2.5/0.1,claude-opus-5-5=4/20/5/0.2
# Agent definitions: <dir>/<name>/agent.md + optional local skills/<skill>/SKILL.md; in the image /app/agents.
# Directories starting with "_" are templates and are not loaded.
AGENTS_DIR=./agents
# Shared skills: <dir>/<skill>/SKILL.md, listed by agents in "skills:"; in the image /app/skills
SKILLS_DIR=./skills

# --- Knowledge base embeddings (key and URL above); vectors must be 1536-dimensional ---
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_BATCH_SIZE=100
EMBEDDINGS_MAX_RETRIES=4
EMBEDDINGS_RETRY_BASE_DELAY=1s
EMBEDDINGS_TIMEOUT=60s
# Folder `kb ingest` takes brand materials from; document sources are paths relative to it.
# Used only by `KB_HOST=1 make kb-*` (go run on the host): in the image make kb-* mounts ./kb at /kb and sets KB_ROOT=/kb.
KB_ROOT=./kb

# --- Tasks: queue (Redis stream) and workers ---
# Tasks run at the same time
TASKS_WORKERS=2
# Runs of a task (or of one revision) before it is given up (a refusal or max_tokens give up at once)
TASKS_MAX_ATTEMPTS=3
# Retry delay = base * 2^(attempt-1), at most max
TASKS_RETRY_BASE_DELAY=30s
TASKS_RETRY_MAX_DELAY=10m
# Timeout of one run; a run older than timeout + 1m is considered dead and restarted
TASKS_TIMEOUT=15m
# On stop running tasks get this long to finish, then return to the queue (shortened to fit APP_STOP_TIMEOUT)
TASKS_SHUTDOWN_GRACE=10s
# Attempts to send a draft (with the retry delays above) before the task fails
TASKS_DELIVERY_ATTEMPTS=5
# How often PostgreSQL is checked for tasks the queue lost
TASKS_SWEEP_INTERVAL=1m
# Redis stream of the queue; retries wait in <stream>:delayed
TASKS_STREAM=tasks

# --- Editor (Монтажёр): jobs of the app for the media worker (docker compose service media-worker) ---
# Redis stream of the jobs; their states and results are keys <stream>:job:<id>, <stream>:result:<id>
EDITOR_STREAM=editor:jobs
# An edit running longer than this since a worker took it fails (backlog: 30 min for a 3-minute source); it holds
# MEDIA_WORKER_FFMPEG_TIMEOUT with the download, the transcription and the upload
EDITOR_JOB_TIMEOUT=60m
# A job waits for a worker this long (sources are edited one by one), then fails without being started;
# together with EDITOR_JOB_TIMEOUT it must stay under 3.5 days (84h), or the start fails
EDITOR_QUEUE_TIMEOUT=3h
# No worker heartbeat this long after the submit and the job not taken: the media-worker is not running, fail at once
EDITOR_WORKER_WAIT=3m
# How often the app checks a job; the worker also wakes the task as soon as the result is stored
EDITOR_POLL_INTERVAL=1m
# (app) The longest reel Instagram publishes; a longer draft (a workout is not shortened) gets a note, not a refusal
EDITOR_REELS_MAX_DURATION=3m
# (app) The longest talking-head reel recommended: a first version longer after the cleaning by more than the 10 %
# margin (over 66 s for 60 s) is shortened by the editor's model to half of it .. it (30-60 s); the trainer may ask
# for another length. 0 turns the selection off
EDITOR_REELS_TARGET_DURATION=60s

# --- Media worker (cmd/media-worker; its compose service gets only the variables listed in docker-compose.yml) ---
# A longer source is refused before it is transcribed
MEDIA_WORKER_MAX_SOURCE_DURATION=10m
# Sources above this size (bytes) in S3 are not downloaded
MEDIA_WORKER_MAX_SOURCE_SIZE=2147483648
# A source that is not 9:16 is brought to 1080x1920: pad (black bars, nothing cut off) or crop (the edges are cut)
MEDIA_WORKER_FIT=pad
# A source whose talking-head cut would keep less than this share (no caption needed) may be a workout: it is planned
# whole and the editor's model decides the mode; 0 turns the check off (only a source without words is decided)
MEDIA_WORKER_MIN_SPEECH_SHARE=0.6
# FFMPEG_TIMEOUT of the worker (one render of a source up to 10 minutes: 4K60 HEVC HDR takes ~22 min on 2 CPUs)
MEDIA_WORKER_FFMPEG_TIMEOUT=40m

# --- docker compose: ports published on 127.0.0.1 ---
APP_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
