# Copy to .env: cp .env.dist .env
# Values below are safe defaults for local development only.

# --- Application ---
LOG_LEVEL=info
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
MIGRATIONS_RUN_ON_START=true

# --- PostgreSQL (also used by the postgres container) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_agents
POSTGRES_SSL_MODE=disable

# --- Redis ---
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- S3 (RustFS in docker compose; keys are also its admin credentials) ---
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=media
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Telegram local Bot API server (compose profile "telegram") ---
# Get them at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- docker compose: ports published on the host ---
APP_HOST_PORT=8080
REDIS_HOST_PORT=6379
S3_HOST_PORT=9000
S3_CONSOLE_HOST_PORT=9001
TELEGRAM_BOT_API_HOST_PORT=8081
